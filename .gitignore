# The base repo and worktrees are managed by their own git: not versioned here.
/workspace/*
!/workspace/README.md

# Module repos are external clones (their own git), and generator artifacts are regenerable.
/modules/installed/*
!/modules/installed/.gitkeep
/modules/output/*
!/modules/output/.gitkeep

# Ephemeral multi-project coordination. Never commit owners or candidates.
.orchestrator/runtime/
/requirements/*.candidate-*
/.orchestrator/projects.yml.candidate-*
/.orchestrator/projects/**/*.candidate-*
/modules/registry.md.candidate-*

# Local Claude Code permissions config (contains paths/approvals for this machine).
.claude/settings.local.json

# Reproducible local checks keep raw output and external drafts off Git.
/tests/harness/results/
/.orchestrator/projects/**/verification/*.log
/.orchestrator/projects/**/integration/*.log
/docs/**/.staging/
/scripts/**/.staging/

# Custom
feature/*
assets/build-gifs/*
legion-modules/*
